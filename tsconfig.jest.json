{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["jest", "node"],
    "rootDir": ".",
    "module": "commonjs",
    "moduleResolution": "node10",
    "customConditions": null,
    "ignoreDeprecations": "6.0",
    "isolatedModules": true
  },
  "include": ["__tests__/**/*.ts"],
  "exclude": ["node_modules"]
}
