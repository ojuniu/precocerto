# Copie para .env e preencha com os dados do seu projeto Supabase
# (Supabase → Project Settings → API). A anon key é pública por design;
# a segurança vem das políticas RLS do banco.
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=SUA_ANON_KEY

# Nome da Edge Function de IA (padrão: ai-vision)
EXPO_PUBLIC_AI_FUNCTION_NAME=ai-vision

# NUNCA coloque chaves de IA aqui. Elas ficam nos secrets da Edge Function:
#   supabase secrets set GEMINI_API_KEY=...
